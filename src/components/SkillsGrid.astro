---
const skillGroups = [
  {
    category: 'Data Layer',
    icon: '🗄️',
    skills: ['Python', 'pandas', 'SQLAlchemy', 'PostgreSQL', 'SQLite', 'ETL Pipelines'],
  },
  {
    category: 'AI & Machine Learning',
    icon: '🧠',
    skills: ['scikit-learn', 'XGBoost', 'MLflow', 'Feature Engineering', 'Model Serving', 'PyTorch'],
  },
  {
    category: 'Agentic Systems',
    icon: '🤖',
    skills: ['LangGraph', 'LangChain', 'CrewAI', 'RAG', 'Tool Use', 'Prompt Engineering'],
  },
  {
    category: 'App Development',
    icon: '⚙️',
    skills: ['FastAPI', 'Pydantic', 'REST APIs', 'Docker', 'Streamlit', 'Typer CLI'],
  },
];
---

<section class="max-w-5xl mx-auto px-6 py-16">
  <h2 class="text-2xl font-bold text-white mb-2">Skills</h2>
  <p class="text-gray-500 text-sm mb-10">What I work with across the data-to-AI stack</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {skillGroups.map((group) => (
      <div class="bg-gray-900 rounded-xl p-6 border border-gray-800 hover:border-gray-700 transition-colors">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-xl">{group.icon}</span>
          <h3 class="text-emerald-400 font-mono text-sm font-semibold uppercase tracking-wider">
            {group.category}
          </h3>
        </div>
        <div class="flex flex-wrap gap-2">
          {group.skills.map((skill) => (
            <span class="bg-gray-800 text-gray-300 text-xs px-3 py-1 rounded-full border border-gray-700">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
